#!/bin/sh /etc/rc.common

START=99
STOP=10
USE_PROCD=1

start_service() {
	if [ "${IPING_UPDATE_START:-0}" != 1 ]; then
		mkdir -p /var/lock
		exec 8>/var/lock/iping-update.lock
		flock -n 8 || return 0
	fi
	procd_open_instance agent
	procd_set_param command /usr/libexec/iping/agent agent
	procd_set_param respawn 3600 5 0
	procd_set_param term_timeout 45
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

reload_service() {
	stop
	start
}

service_triggers() {
	procd_add_reload_trigger iping
}
