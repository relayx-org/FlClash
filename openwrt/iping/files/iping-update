#!/bin/sh
set -eu

work=''
restore_service=0
repositories_updated=0
auto_update=''
mode=install
scheduled=0
staged=''
backup=''
replaced=0

fail() { echo "iPing: $*" >&2; exit 1; }

cleanup() {
    result=$?
    trap - 0
    set +e
    if [ "$result" != 0 ] && [ "$replaced" = 1 ]; then
        /etc/init.d/iping stop
        rm -rf /usr/libexec/iping
        if mv "$backup" /usr/libexec/iping; then
            echo 'iPing: restored the previous binaries' >&2
        else echo "iPing: recovery files remain at $backup" >&2; fi
        backup=''
    fi
    if [ "$restore_service" = 1 ]; then
        IPING_UPDATE_START=1 /etc/init.d/iping start || echo 'iPing: could not restore the service' >&2
    fi
    [ -z "$staged" ] || rm -rf "$staged"
    [ -z "$backup" ] || rm -rf "$backup"
    [ -z "$work" ] || rm -rf "$work"
    exit "$result"
}

update_repositories() {
    [ "$repositories_updated" = 0 ] || return 0
    "$manager" update
    repositories_updated=1
}

detect_platform() {
    [ -f /etc/openwrt_release ] || fail 'this installer requires OpenWrt'
    # shellcheck source=/dev/null
    . /etc/openwrt_release
    if command -v opkg >/dev/null; then manager=opkg
    elif command -v apk >/dev/null; then manager=apk
    else fail 'opkg or apk is required to install runtime dependencies'; fi
    machine=${DISTRIB_ARCH:-}
    if [ -z "$machine" ]; then
        if [ "$manager" = opkg ]; then
            machine=$(opkg print-architecture | sort -nk3 | tail -n1 | awk '{print $2}')
        else machine=$(apk --print-arch); fi
    fi
    case "$machine" in
        x86_64) arch=x86_64 ;;
        aarch64|arm64|aarch64_*) arch=aarch64 ;;
        arm_cortex-a[5789]*|arm_cortex-a1[57]*|arm_cortex-a53*|armv7*) arch=armv7 ;;
        mips_*) arch=mips ;;
        mipsel_*) arch=mipsel ;;
        *) fail "unsupported CPU architecture: $machine" ;;
    esac
}

ensure_tools() {
    set --
    for tool in curl jsonfilter unzip flock; do
        command -v "$tool" >/dev/null || set -- "$@" "$tool"
    done
    if [ "$#" -gt 0 ]; then
        [ "$scheduled" = 0 ] || fail 'update dependencies are missing; rerun the installer'
        update_repositories
        if [ "$manager" = opkg ]; then
            opkg install ca-bundle "$@"
        else
            apk add ca-bundle "$@"
        fi
    fi
    command -v sha256sum >/dev/null || fail 'sha256sum is required'
}

schedule_updates() {
    mkdir -p /etc/crontabs
    cron=$(mktemp /tmp/iping-cron.XXXXXX)
    if [ -f /etc/crontabs/root ]; then
        sed '\|# iping-auto-update$|d' /etc/crontabs/root > "$cron"
    fi
    schedule_enabled=$(uci -q get iping.config.auto_update || echo 1)
    if [ "$schedule_enabled" = 1 ]; then
        minute=$(uci -q get iping.config.update_minute || true)
        case "$minute" in
            ''|*[!0-9]*) minute=$(awk 'BEGIN { srand(); print int(rand() * 60) }') ;;
        esac
        [ "$minute" -le 59 ] || { rm -f "$cron"; fail 'update_minute must be between 0 and 59'; }
        uci set "iping.config.update_minute=$minute"
        uci commit iping
        printf '%s 4 * * * /usr/libexec/iping/update --scheduled 2>&1 | logger -t iping-update # iping-auto-update\n' "$minute" >> "$cron"
    fi
    crontab "$cron"
    rm -f "$cron"
    if [ "$schedule_enabled" = 1 ]; then
        /etc/init.d/cron enable
        /etc/init.d/cron restart
    elif /etc/init.d/cron running; then
        /etc/init.d/cron restart
    fi
}

download() {
    curl --fail --location --silent --show-error --retry 3 --connect-timeout 15 \
        --max-time 300 --proto '=https' --proto-redir '=https' --output "$2" "$1"
    [ -s "$2" ] || fail "empty download: $1"
}

field() { jsonfilter -i "$work/latest.json" -e "$1"; }

valid_version() { echo "$1" | grep -Eq '^[0-9]+\.[0-9]+\.[0-9]+\+[1-9][0-9]{0,14}$'; }

newer() {
    awk -v incoming="$1" -v current="$2" 'BEGIN {
        split(incoming, n, /[.+]/); split(current, c, /[.+]/);
        for (i = 1; i <= 4; i++) {
            if (n[i] + 0 > c[i] + 0) exit 0;
            if (n[i] + 0 < c[i] + 0) exit 1;
        }
        exit 1;
    }'
}

unpack_binaries() {
    mkdir "$work/payload"
    unzip -p "$work/bundle.zip" SHA256SUMS > "$work/SHA256SUMS"
    count=0
    seen=' '
    while read -r digest name extra; do
        if [ -n "$extra" ] || [ "${#digest}" != 64 ]; then fail 'invalid binary checksums'; fi
        case "$digest" in *[!0-9a-f]*) fail 'invalid binary checksum' ;; esac
        case "$name" in
            agent|mihomo|update|iping.init|iping.conf|iping.upgrade|version|LICENSE) ;;
            *) fail "unexpected release file: $name" ;;
        esac
        case "$seen" in *" $name "*) fail 'duplicate release file' ;; esac
        seen="$seen$name "
        count=$((count + 1))
        unzip -p "$work/bundle.zip" "$name" > "$work/payload/$name"
        [ -s "$work/payload/$name" ] || fail "empty release file: $name"
        printf '%s  %s\n' "$digest" "$work/payload/$name" | sha256sum -c -
    done < "$work/SHA256SUMS"
    [ "$count" = 8 ] || fail 'incomplete binary release'
    [ "$(cat "$work/payload/version")" = "$target" ] || fail 'release version mismatch'
    chmod 755 "$work/payload/agent" "$work/payload/mihomo" "$work/payload/update" "$work/payload/iping.init"
    chmod 644 "$work/payload/iping.conf" "$work/payload/iping.upgrade" "$work/payload/version" "$work/payload/LICENSE"
}

ensure_runtime() {
    [ "$scheduled" = 0 ] || return 0
    set --
    for package in ca-bundle ip-full nftables-json firewall4 kmod-tun kmod-inet-diag kmod-nft-tproxy kmod-nft-socket; do
        if [ "$manager" = opkg ]; then
            opkg status "$package" | grep -q '^Status: .* installed$' || set -- "$@" "$package"
        else
            apk info -e "$package" >/dev/null 2>&1 || set -- "$@" "$package"
        fi
    done
    [ "$#" -gt 0 ] || return 0
    update_repositories
    if [ "$manager" = opkg ]; then opkg install "$@"; else apk add "$@"; fi
}

stage_binaries() {
    mkdir -p /usr/libexec /usr/share/iping /usr/bin /etc/init.d /etc/config /lib/upgrade/keep.d
    available=$(df -Pk /usr/libexec | awk 'END { print $4 * 1024 }')
    required=$(du -sk "$work/payload" | awk '{ print $1 * 1024 + 8388608 }')
    awk -v available="$available" -v required="$required" 'BEGIN { exit !(available >= required) }' || fail 'not enough router storage for the new binaries'
    staged=$(mktemp -d /usr/libexec/iping-new.XXXXXX)
    cp -p "$work/payload/"* "$staged/"
}

activate_binaries() {
    backup=$(mktemp -d /usr/libexec/iping-previous.XXXXXX)
    previous=/usr/libexec/iping
    [ -d "$previous" ] || previous=$backup
    for pair in 'iping.init:/etc/init.d/iping' 'version:/usr/share/iping/version' 'iping.upgrade:/lib/upgrade/keep.d/iping'; do
        name=${pair%%:*}
        path=${pair#*:}
        if [ ! -e "$previous/$name" ] && [ -f "$path" ]; then cp -pL "$path" "$previous/$name"; fi
    done
    if [ "$previous" != "$backup" ]; then
        rmdir "$backup"
        mv /usr/libexec/iping "$backup"
    fi
    replaced=1
    mv "$staged" /usr/libexec/iping
    staged=''
    ln -sf /usr/libexec/iping/iping.init /etc/init.d/iping
    ln -sf /usr/libexec/iping/version /usr/share/iping/version
    ln -sf /usr/libexec/iping/iping.upgrade /lib/upgrade/keep.d/iping
    ln -sf /usr/libexec/iping/update /usr/bin/iping-update
    if [ ! -f /etc/config/iping ]; then
        cp /usr/libexec/iping/iping.conf /etc/config/iping
        chmod 600 /etc/config/iping
    fi
}

show_address() {
    address=$(uci -q get network.lan.ipaddr || echo '<router-LAN-address>')
    listener=$(uci -q get iping.config.web_listen || echo '0.0.0.0:19091')
    echo "iPing is ready: http://$address:${listener##*:}/"
    secure_listener=$(uci -q get iping.config.web_tls_listen || true)
    if [ -n "$secure_listener" ]; then
        echo "HTTPS: https://$address:${secure_listener##*:}/"
    fi
    echo 'Open the address and sign in with your iPing account.'
}

main() {
    [ "$(id -u)" = 0 ] || fail 'run this installer as root'
    case "${1:-}" in
        auto)
            case "${2:-}" in on) value=1 ;; off) value=0 ;; *) fail 'usage: iping-update auto on|off' ;; esac
            uci set "iping.config.auto_update=$value"
            uci commit iping
            schedule_updates
            exit 0 ;;
        schedule) schedule_updates; exit 0 ;;
    esac
    for argument in "$@"; do
        case "$argument" in
            install|update|check) mode=$argument ;;
            --scheduled) mode=update; scheduled=1 ;;
            --no-auto-update) auto_update=0 ;;
            --auto-update) auto_update=1 ;;
            -h|--help) echo 'Usage: iping-update [install|update|check|auto on|auto off] [--no-auto-update]'; exit 0 ;;
            *) fail "unknown argument: $argument" ;;
        esac
    done
    if [ "$scheduled" = 1 ] && [ "$(uci -q get iping.config.auto_update || echo 1)" != 1 ]; then exit 0; fi
    detect_platform
    ensure_tools
    mkdir -p /var/lock
    exec 9>/var/lock/iping-update.lock
    flock -n 9 || fail 'another iPing installation or update is running'
    work=$(mktemp -d /tmp/iping-update.XXXXXX)
    trap cleanup 0
    trap 'exit 130' INT
    trap 'exit 143' TERM
    base_url=${IPING_UPDATE_BASE_URL:-$(uci -q get iping.config.update_url || echo 'https://video.iping.my/releases/')}
    case "$base_url" in https://*/*/) ;; *) fail 'the update URL must use HTTPS and end in /' ;; esac
    download "${base_url}latest.json" "$work/latest.json"
    [ "$(field '@.schemaVersion')" = 1 ] || fail 'unsupported update manifest'
    [ "$(field '@.packageId')" = my.iping.client ] || fail 'invalid update package ID'
    version=$(field '@.version')
    build=$(field '@.buildNumber')
    target="$version+$build"
    valid_version "$target" || fail 'invalid release version'
    filename="iPing-${version}-openwrt-${arch}.zip"
    key="@.downloads[\"openwrt-${arch}\"]"
    url=$(field "$key.url")
    size=$(field "$key.size")
    digest=$(field "$key.sha256")
    [ "$url" = "${base_url}${target}/${filename}" ] || fail "no matching binary release for $arch"
    case "$size" in ''|*[!0-9]*) fail 'invalid release size' ;; esac
    if [ "${#size}" -gt 10 ] || [ "$size" -le 0 ]; then fail 'invalid release size'; fi
    [ "${#digest}" = 64 ] || fail 'invalid release checksum'
    case "$digest" in *[!0-9a-f]*) fail 'invalid release checksum' ;; esac
    installed=$(cat /usr/share/iping/version 2>/dev/null || true)
    if [ -n "$installed" ]; then
        valid_version "$installed" || fail 'invalid installed version'
        if ! newer "$target" "$installed"; then
            echo "iPing $installed is current; no update needed."
            if [ "$mode" = install ]; then
                if [ -n "$auto_update" ]; then uci set "iping.config.auto_update=$auto_update"; uci commit iping; fi
                schedule_updates
                /etc/init.d/iping enable
                IPING_UPDATE_START=1 /etc/init.d/iping start
                show_address
            fi
            exit 0
        fi
    fi
    echo "iPing: ${installed:-not installed} -> $target (OpenWrt / $arch)"
    [ "$mode" != check ] || exit 0
    available=$(df -Pk /tmp | awk 'END { print $4 * 1024 }')
    awk -v available="$available" -v size="$size" 'BEGIN { exit !(available >= size * 4 + 16777216) }' || fail 'not enough temporary space for download and verification'
    download "$url" "$work/bundle.zip"
    [ "$(wc -c < "$work/bundle.zip" | tr -d ' ')" = "$size" ] || fail 'incomplete release download'
    printf '%s  %s\n' "$digest" "$work/bundle.zip" | sha256sum -c -
    unpack_binaries
    ensure_runtime
    stage_binaries
    was_running=0
    if [ -x /etc/init.d/iping ] && /etc/init.d/iping running; then was_running=1; fi
    if [ "$was_running" = 1 ]; then
        restore_service=1
        /etc/init.d/iping stop
    fi
    activate_binaries
    if [ -n "$auto_update" ]; then uci set "iping.config.auto_update=$auto_update"; fi
    if [ -n "${IPING_UPDATE_BASE_URL:-}" ]; then uci set "iping.config.update_url=$base_url"; fi
    uci commit iping
    schedule_updates
    if [ "$mode" = install ]; then /etc/init.d/iping enable; fi
    if [ "$mode" = install ] || [ "$was_running" = 1 ]; then
        IPING_UPDATE_START=1 /etc/init.d/iping start
    fi
    restore_service=0
    echo "iPing $target installed."
    [ "$scheduled" = 1 ] || show_address
}

main "$@"
